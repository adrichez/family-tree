    %% Estilos para Nodos (Individuos)
    classDef hombre fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#000,rx:8,ry:8
    classDef mujer fill:#FCE4EC,stroke:#C2185B,stroke-width:2px,color:#000,rx:8,ry:8
    classDef sin_especificar fill:#FFE0B2,stroke:#FB8C00,stroke-width:2px,color:#000,rx:8,ry:8

    %% Estilo para Uniones (Matrimonios)
    classDef union fill:#78909C,stroke:none,color:transparent

    %% Estilo para el marco de cada generación
    classDef marco_generacion fill:#78909C14,stroke:#546E7A,stroke-width:2px,stroke-dasharray: 5 5,rx:12,ry:12

    %% Estilo para las sub-ramas (paterna/materna) dentro de la generación
    classDef marco_rama fill:#90A4AE0D,stroke:#90A4AE,stroke-width:1px,stroke-dasharray: 3 3,rx:8,ry:8

    %% Estilo para grupos familiares (núcleos de misma familia/apellidos)
    classDef marco_nucleo fill:transparent,stroke:#B0BEC5,stroke-width:1px,stroke-dasharray: 2 2,rx:6,ry:6

    %% Estilo para Conexiones (Parentesco)
    linkStyle default stroke:#78909C,stroke-width:2px;








